## RDP into Work Laptop Using BitWarden ##
function workrdp() {
  bw-auth
  echo "Retrieving RDP Vault Secret"
  local vault_json=$(bw get item "bw-kopis" --session "$BW_SESSION")
  if [ $? -ne 0 ]; then
    echo "Failed to retrieve item from Bitwarden."
    return 1
  fi
  # Parse the domain from the item JSON jq -r '.fields[] | "export \(.name)=\(.value)"')
  local domain=$(echo "$vault_json" | jq -r '.fields[] | select(.name == "domain") | .value')
  # Parse the username from the item JSON
  local user=$(echo "$vault_json" | jq -r '.fields[] | select(.name == "username") | .value')
  # Parse the lan_ip (eth0) from the item JSON
  local lan_ip=$(echo "$vault_json" | jq -r '.fields[] | select(.name == "eth0") | .value')
  local mac=$(echo "$vault_json" | jq -r '.fields[] | select(.name == "mac") | .value')
  # Use jq to extract the name and value fields and prefix them with 'export'
  local password=$(echo "$vault_json" | jq -r '.login.password') 
  echo "wakeonlan $mac"
  echo "xfreerdp /u:$user /d:$domain /v:$lan_ip:3389 /dynamic-resolution /multimon /audio-mode:1 /network:LAN +clipboard +fonts /cert:ignore /p:$password" 
}

## Programming Helper ##
# changes the date on a file if it has Author tag
function newdate() {
  today_=$(date +%Y-%m-%d)
  tag_="LastEdit:"
  updated_files=()

  process_file() {
    local file_="$1"
    [[ -f "$file_" ]] || return

    if grep -q "$tag_" "$file_"; then
      sed -i "s/\($tag_ \)[0-9\-]*/\1$today_/g" "$file_"
      updated_files+=("$file_")
    elif grep -q "Author:" "$file_"; then
      sed -i "s/\(Author:.*\)/\1 | $tag_ $today_/" "$file_"
      updated_files+=("$file_")
    fi
  }

  for arg in "$@"; do
    if [[ -d "$arg" ]]; then
      while IFS= read -r -d '' file_; do
        process_file "$file_"
      done < <(find "$arg" -type f -print0)
    elif [[ -f "$arg" ]]; then
      process_file "$arg"
    else
      echo "Warning: '$arg' is not a valid file or directory" >&2
    fi
  done

  if (( ${#updated_files[@]} > 0 )); then
    echo "Updated ${#updated_files[@]} file(s) with '$tag_ $today_':"
    printf ' - %s\n' "${updated_files[@]}"
  else
    echo "No files were updated."
  fi
}


