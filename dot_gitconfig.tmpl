[user]
  email = logan.mancuso@scoutmotors.com
  name = Logan Mancuso
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMbGXnZD4zpYPsAsvqtalK6S3sjDrPxICil74FDFY62T
[gpg]
  format = ssh
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
  allowedSignersFile = {{ .chezmoi.homeDir }}/.ssh/allowed_signers
[safe]
  directory = {{ .chezmoi.homeDir }}/SourceControl/*
[core]
  autocrlf = input
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential]
	helper = 1password
