function delete() {
  for item in "$@"; do
    mv "$item" "$HOME/.Trash"
  done
}

function extract() {
  local file_name_="$1"
  if [ -z "$file_name_" ]; then
    echo "Usage: extract <path/file_name>.<zip|rar|bz2|gz|tar|tbz2|tgz|Z|7z|xz|ex|tar.bz2|tar.gz|tar.xz>"
  else
    if [ -f "$file_name_" ]; then
      case $file_name_ in
        *.tar.bz2)   tar xvjf "$file_name_"    ;;
        *.tar.gz)    tar xvzf "$file_name_"    ;;
        *.tar.xz)    tar xvJf "$file_name_"    ;;
        *.lzma)      unlzma "$file_name_"      ;;
        *.bz2)       bunzip2 "$file_name_"     ;;
        *.rar)       unrar x -ad "$file_name_" ;;
        *.gz)        gunzip "$file_name_"      ;;
        *.tar)       tar xvf "$file_name_"     ;;
        *.tbz2)      tar xvjf "$file_name_"   ;;
        *.tgz)       tar xvzf "$file_name_"   ;;
        *.zip)       unzip "$file_name_"       ;;
        *.Z)         uncompress "$file_name_"  ;;
        *.7z)        7z x "$file_name_"        ;;
        *.xz)        unxz "$file_name_"        ;;
        *.exe)       cabextract "$file_name_"  ;;
        *)           echo "extract: '$file_name_' - unknown archive method" ;;
      esac
    else
      echo "$file_name_ - file does not exist"
    fi
  fi
}

function stopwatch() {
  echo "Stopwatch started. [SPACE] to pause/resume, [q] to stop."

  stty -echo -icanon time 0 min 0
  start=$(date +%s)
  paused=0
  total_pause=0
  pause_start=0
  while true; do
    key=$(dd bs=1 count=1 2>/dev/null)

    if [[ $key == $'\x20' ]]; then  # Spacebar
      if [[ $paused -eq 0 ]]; then
        pause_start=$(date +%s)
        paused=1
        echo -e "\nPaused... "
      else
        pause_end=$(date +%s)
        total_pause=$((total_pause + pause_end - pause_start))
        paused=0
        echo "Resumed."
      fi
    elif [[ $key == "q" ]]; then
      break
    fi

    if [[ $paused -eq 0 ]]; then
      now=$(date +%s)
      elapsed=$((now - start - total_pause))
      printf "\rElapsed time: %02d:%02d:%02d" $((elapsed/3600)) $(((elapsed%3600)/60)) $((elapsed%60))
    fi

    sleep 1
  done

  stty sane
  echo
}

function ouch-counter() {
  local rate_per_sec=83.3333  # $5000/min
  echo "🔥 Line stopped, no pressure.... [SPACE] pause/resume, [q] quit."
  echo ""

  stty -echo -icanon time 0 min 0
  start=$(date +%s)
  paused=0
  total_pause=0
  pause_start=0

  while true; do
    key=$(dd bs=1 count=1 2>/dev/null)

    if [[ $key == $'\x20' ]]; then
      if [[ $paused -eq 0 ]]; then
        pause_start=$(date +%s)
        paused=1
        echo -e "\nPaused... (clock stopped, wallet safe)"
      else
        pause_end=$(date +%s)
        total_pause=$((total_pause + pause_end - pause_start))
        paused=0
        echo "Resumed. Ouch."
      fi
    elif [[ $key == "q" ]]; then
      break
    fi

    if [[ $paused -eq 0 ]]; then
      now=$(date +%s)
      elapsed=$((now - start - total_pause))
      cost=$(awk "BEGIN { printf \"%.2f\", $elapsed * $rate_per_sec }")
      cost_fmt=$(awk "BEGIN { printf \"%\047.2f\", $elapsed * $rate_per_sec }" 2>/dev/null || echo "$cost")
      printf "\rDown: %02d:%02d:%02d | Burned: \$%s 💸🔥" \
        $((elapsed/3600)) $(((elapsed%3600)/60)) $((elapsed%60)) "$cost_fmt"
    fi

    sleep 1
  done

  stty sane
  now=$(date +%s)
  elapsed=$((now - start - total_pause))
  cost=$(awk "BEGIN { printf \"%\047.2f\", $elapsed * $rate_per_sec }" 2>/dev/null || awk "BEGIN { printf \"%.2f\", $elapsed * $rate_per_sec }")
  echo ""
  echo ""
  echo "Line was down ${elapsed}s. Total damage: \$$cost"
  echo "Hope it was worth it."
}

function timer() {
  while true; do
    echo -ne "$(date +%H:%M:%S:%N)\r"
  done
}

