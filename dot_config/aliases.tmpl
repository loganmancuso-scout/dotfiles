# Smart switch: auto-pulls when landing on main
function gco() {
  git switch "$@"
  [[ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" == "main" ]] && git pull
}

# Create and switch to a new branch
function gnb() {
  if [[ -z "$1" ]]; then
    echo "Usage: gnb <branch-name>"
    return 1
  fi
  git switch -c "$1"
}

# Finish a feature branch: switch to main, pull, delete locally + remotely
# Usage: gclean [branch] [--force]
function gclean() {
  local branch=""
  local force=false

  for arg in "$@"; do
    case "$arg" in
      --force) force=true ;;
      *)       branch="$arg" ;;
    esac
  done

  branch="${branch:-$(git rev-parse --abbrev-ref HEAD 2>/dev/null)}"

  if [[ "$branch" == "main" ]]; then
    echo "Already on main, nothing to clean."
    return 1
  fi

  git switch main && git pull || return 1

  if $force; then
    git branch -D "$branch" && echo "Force deleted local branch: $branch"
  else
    git branch -d "$branch" && echo "Deleted local branch: $branch"
  fi

  git push origin --delete "$branch" 2>/dev/null && echo "Deleted remote branch: $branch"
  git fetch --prune
}

# ─────────────────────────────────────────
# KUBERNETES
# ─────────────────────────────────────────
alias k="kubectl"

function kconf() {
  local kubeconfig_dir="$HOME/.kube"
  local config_name="$1"

  if [ -z "$config_name" ]; then
    echo "Available kubeconfigs:"
    [ -d "$kubeconfig_dir" ] && ls -1 "$kubeconfig_dir" | grep -E '(config|.*\.yaml)' | sed 's/^/  /'
    return 0
  fi

  # Check if it's the local config
  if [ "$config_name" = "config" ]; then
    export KUBECONFIG="$kubeconfig_dir/config"
    echo "✓ Switched to $config_name"
    kubectl cluster-info 2>/dev/null | head -1 || echo "  (kubeconfig set)"
    return 0
  fi

  # Check for name-kubeconfig.yaml pattern
  local config_file="$kubeconfig_dir/$config_name.yaml"
  if [ -f "$config_file" ]; then
    export KUBECONFIG="$config_file"
    echo "✓ Switched to $config_name"
    kubectl cluster-info 2>/dev/null | head -1 || echo "  (kubeconfig set)"
    return 0
  fi

  # Try exact filename
  config_file="$kubeconfig_dir/$config_name"
  if [ -f "$config_file" ]; then
    export KUBECONFIG="$config_file"
    echo "✓ Switched to $config_name"
    kubectl cluster-info 2>/dev/null | head -1 || echo "  (kubeconfig set)"
    return 0
  fi

  echo "Error: Kubeconfig '$config_name' not found in $kubeconfig_dir"
  return 1
}

