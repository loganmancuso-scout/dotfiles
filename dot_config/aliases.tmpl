function tflogin() {
  local env=$1
  
  # Validate environment parameter
  if [ -z "$env" ]; then
    echo "Error: Environment parameter required"
    echo "Usage: tflogin <environment>"
    echo "Example: tflogin dev-core"
    return 1
  fi
  
  # Validate environment is one of the supported values
  if [[ "$env" != "dev-core" && "$env" != "core" ]]; then
    echo "Error: Invalid environment '$env'"
    echo "Supported environments: dev-core, core"
    return 1
  fi
  eval $(op signin)
  echo "Setting $env OpenBao Secrets"
  # set vault url and vault token and unseal key
  export BAO_ADDR="$(op item get "Tofu $env-OpenBao" --format json | jq -r '.urls[0].href')"
  export VAULT_ADDR="$BAO_ADDR"
  export BAO_TOKEN="$(op item get "Tofu $env-OpenBao" --fields label=password --reveal)"
  export VAULT_TOKEN="$BAO_TOKEN"
  export UNSEAL_KEY_1="$(op item get "Tofu $env-OpenBao" --fields label="UNSEAL_KEY_1")"
  echo "Setting $env RustFS Secrets"
  # set rustfs secret token and secret id
  export AWS_ACCESS_KEY_ID="$(op item get "rustfs $env-automation-accesskey" --vault "automation" --fields label=username)"
  export AWS_SECRET_ACCESS_KEY="$(op item get "rustfs $env-automation-accesskey" --vault "automation" --fields label=password --reveal)"
  # set op service account secret token
  echo "Setting $env 1Password Secrets"
  export OP_CONNECT_TOKEN="$(op item get "$env Access Token: OpenTofu" --fields label=credential --reveal)"
}

function tfunseal() {
  [[ -z "$UNSEAL_KEY_1" || -z "$BAO_TOKEN" ]] && tflogin
  bao status -tls-skip-verify
  bao operator unseal -tls-skip-verify $UNSEAL_KEY_1
  bao status -tls-skip-verify
  bao login -tls-skip-verify token=$BAO_TOKEN
}
