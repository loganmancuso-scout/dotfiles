function watch-ping() {
  # Usage: watch-ping <host> [ping-args]
  while true; do
    ts=$(date '+%m/%d-%H:%M:%S')
    out=$(ping -c 1 -W 5000 "$@" 2>&1 | grep -E 'time=|timeout|unreachable|unknown')
    echo "$ts\t${out:-No response}"
    sleep 1
  done
}

function ping-multi() {
  # Usage: ping-multi <host1> <host2> ... <hostN>
  # Compatible with both bash and zsh
  if [[ $# -eq 0 ]]; then
    echo "Usage: ping-multi <host1> <host2> ... <hostN>"
    return 1
  fi

  # suppress job control output (zsh and bash)
  if [[ -n "$ZSH_VERSION" ]]; then
    setopt LOCAL_OPTIONS NO_MONITOR
  else
    set +m
  fi

  # declare all locals up front to avoid zsh printing assignments in loops
  local host ts statedir tmpdir result s r st lat pct
  local hosts=("$@")

  statedir=$(mktemp -d)

  for host in "${hosts[@]}"; do
    echo 0 > "$statedir/${host}.sent"
    echo 0 > "$statedir/${host}.recv"
  done

  _ping_multi_cleanup() {
    tput cnorm
    rm -rf "$statedir"
    echo
  }
  trap '_ping_multi_cleanup; return 0' INT

  tput civis  # hide cursor

  while true; do
    ts=$(date '+%m/%d-%H:%M:%S')
    tmpdir=$(mktemp -d)

    # fire all pings in parallel
    for host in "${hosts[@]}"; do
      (
        out=$(ping -c 1 -W 5000 "$host" 2>&1)
        latency=$(echo "$out" | grep -oE 'time=[0-9.]+ ms' | head -1)
        if [[ -n "$latency" ]]; then
          echo "UP|${latency}" > "$tmpdir/${host}.result"
        else
          echo "DOWN|-" > "$tmpdir/${host}.result"
        fi
      ) &
    done
    wait

    # read results and update counters
    for host in "${hosts[@]}"; do
      result=$(cat "$tmpdir/${host}.result" 2>/dev/null || echo "DOWN|-")
      st=$(echo "$result" | cut -d'|' -f1)
      lat=$(echo "$result" | cut -d'|' -f2)
      s=$(cat "$statedir/${host}.sent")
      r=$(cat "$statedir/${host}.recv")
      s=$(( s + 1 ))
      [[ "$st" == "UP" ]] && r=$(( r + 1 ))
      echo "$s"  > "$statedir/${host}.sent"
      echo "$r"  > "$statedir/${host}.recv"
      echo "$st"  > "$statedir/${host}.status"
      echo "$lat" > "$statedir/${host}.latency"
    done

    rm -rf "$tmpdir"

    # redraw table
    clear
    printf "ping-multi | refreshed %s\n\n" "$ts"
    printf "%-20s %-8s %-14s %-10s %-6s %-6s\n" "HOST" "STATUS" "LATENCY" "UPTIME%" "SENT" "RECV"
    printf "%-20s %-8s %-14s %-10s %-6s %-6s\n" "--------------------" "--------" "--------------" "----------" "------" "------"

    for host in "${hosts[@]}"; do
      s=$(cat "$statedir/${host}.sent")
      r=$(cat "$statedir/${host}.recv")
      st=$(cat "$statedir/${host}.status")
      lat=$(cat "$statedir/${host}.latency")
      pct=$(awk "BEGIN { printf \"%.1f\", ($r / ($s > 0 ? $s : 1)) * 100 }")
      printf "%-20s %-8s %-14s %-10s %-6s %-6s\n" "$host" "$st" "$lat" "${pct}%" "$s" "$r"
    done

    sleep 1
  done
}

function watch-nc() {
  # Usage: watch-nc <host> <port>
  local host="$1"
  local port="$2"
  while true; do
    local ts=$(date '+%m/%d-%H:%M:%S')
    if nc -z -w 2 "$host" "$port" 2>/dev/null; then
      echo "$ts\t$host:$port\tOPEN"
    else
      echo "$ts\t$host:$port\tCLOSED/REFUSED"
    fi
    sleep 1
  done
}

function monitor-spinner() {
  local start_time="$1"
  local spinner='|/-\\'
  local spin_idx=0
  while true; do
    local elapsed=$(( $(date +%s) - start_time ))
    local spin_char=$(printf "%s" "$spinner" | cut -c$((spin_idx+1)))
    printf "\r[%s] Monitoring... Elapsed: %ds" "$spin_char" "$elapsed"
    spin_idx=$(( (spin_idx + 1) % 4 ))
    sleep 0.1
  done
}

function monitor-hosts() {
  local interval="30s"
  local silent=false
  local port=22
  local hosts=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --interval) interval="$2"; shift 2 ;;
      --silent)   silent=true; shift ;;
      --port)     port="$2"; shift 2 ;;
      *)          hosts+=("$1"); shift ;;
    esac
  done

  if [[ ${#hosts[@]} -eq 0 ]]; then
    echo "Usage: monitor-hosts [--interval <time>] [--silent] [--port <port>] <host1> [host2 ...]"
    return 1
  fi

  local start_time=$(date +%s)
  local spinner_pid=""

  if [[ "$silent" == true ]]; then
    monitor-spinner "$start_time" &
    spinner_pid=$!
  fi

  local running=true
  trap 'running=false; [[ -n "$spinner_pid" ]] && kill "$spinner_pid" 2>/dev/null; printf "\n"' SIGINT EXIT

  while $running; do
    for host in "${hosts[@]}"; do
      local ts=$(date '+%m/%d %H:%M:%S')
      local logfile="monitor_${host}.log"

      local ping_out=$(ping -c 1 "$host" | grep 'time=')
      local ping_status=$([[ -n "$ping_out" ]] && echo "UP" || echo "DOWN")

      nc -z -w 2 "$host" "$port" >/dev/null 2>&1
      local tcp_status=$([[ $? -eq 0 ]] && echo "PORT $port OPEN" || echo "PORT $port CLOSED")

      printf "%s | %-12s | %-4s | %-16s\n" "$ts" "$host" "$ping_status" "$tcp_status" >> "$logfile"

      if [[ "$silent" == false ]]; then
        printf "%s | %-12s | %-4s | %-16s\n" "$ts" "$host" "$ping_status" "$tcp_status"
      fi
    done
    sleep "$interval"
  done
}

