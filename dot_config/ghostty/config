# ~/.config/ghostty/config.toml
#
# Base/shared settings. Font size is set per-profile — see config-work and
# config-personal in this same directory. Launch a profile with:
#   ghostty --config-file=<path-to-profile>

font-family = "SauceCodePro NFM"

theme = "Catppuccin Mocha"

background-opacity = 0.95

window-height = 40
window-width = 90
