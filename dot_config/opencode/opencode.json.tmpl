{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "github-copilot": {}{{ if eq .profile "personal" }},
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "https://ollama.apps.vpc.home.arpa/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "qwen3-coder:30b",
          "tools": true
        },
        "qwen2.5-coder:7b": {
          "name": "qwen2.5-coder:7b",
          "tools": true
        },
        "deepseek-coder-v2:latest": {
          "name": "deepseek-coder-v2:latest"
        },
        "devstral:24b": {
          "name": "devstral:24b",
          "tools": true
        },
        "deepseek-r1:8b": {
          "name": "deepseek-r1:8b",
          "reasoning": true
        }
      }
    }{{ end }}
  },

  "model": "amazon-bedrock/us.anthropic.claude-sonnet-5",

  "permission": {
    "edit": {
      "*": "ask",
      "~/SourceControl/**": "allow",
      "~/Documents/Notes/**": "allow"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "grep*": "allow",
      "find*": "allow",
      "rg*": "allow",
      "tail*": "allow",
      "head*": "allow",
      "which*": "allow",
      "whereis*": "allow",
      "jq*": "allow",
      "yq*": "allow",
      "curl*": "allow",
      "wget*": "allow",
      "ping*": "allow",
      "dig*": "allow",
      "nslookup*": "allow",
      "host*": "allow",
      "nc*": "allow",
      "netcat*": "allow",
      "traceroute*": "allow",
      "netstat*": "allow",
      "ss*": "allow",
      "source ~/.config/aliases": "allow",
      "tflogin*": "allow",
      "kubeconfig*": "allow",
      "kconf*": "allow",
      "kubectl get*": "allow",
      "kubectl describe*": "allow",
      "kubectl logs*": "allow",
      "kubectl top*": "allow",
      "kubectl config*": "allow",
      "kubectl cluster-info*": "allow",
      "kubectl version": "allow",
      "kubectl api-resources": "allow",
      "kubectl api-versions": "allow",
      "kubectl explain*": "allow",
      "kubectl port-forward*": "allow",
      "kubectl apply*": "ask",
      "kubectl delete*": "ask",
      "kubectl scale*": "ask",
      "kubectl rollout*": "ask",
      "kubectl exec*": "ask",
      "kubectl debug*": "ask",
      "helm list*": "allow",
      "helm status*": "allow",
      "helm get*": "allow",
      "helm history*": "allow",
      "helm search*": "allow",
      "helm show*": "allow",
      "helm version": "allow",
      "helm diff*": "allow",
      "helm upgrade*": "ask",
      "helm install*": "ask",
      "helm uninstall*": "ask",
      "helm rollback*": "ask",
      "docker ps*": "allow",
      "docker images*": "allow",
      "docker inspect*": "allow",
      "docker logs*": "allow",
      "docker version": "allow",
      "docker info": "allow",
      "docker stats*": "allow",
      "docker network ls*": "allow",
      "docker volume ls*": "allow",
      "docker build*": "ask",
      "docker run*": "ask",
      "docker compose*": "ask",
      "docker push*": "ask",
      "docker pull*": "ask",
      "docker exec*": "ask",
      "docker stop*": "ask",
      "docker start*": "ask",
      "docker restart*": "ask",
      "docker rm*": "ask",
      "docker rmi*": "ask",
      "tofu version": "allow",
      "tofu fmt*": "allow",
      "tofu validate*": "allow",
      "tofu show*": "allow",
      "tofu output*": "allow",
      "tofu state list*": "allow",
      "tofu state show*": "allow",
      "tofu workspace*": "allow",
      "tofu providers*": "allow",
      "tofu plan*": "ask",
      "tofu apply*": "ask",
      "tofu destroy*": "ask",
      "tofu init*": "ask",
      "terraform version": "allow",
      "terraform fmt*": "allow",
      "terraform validate*": "allow",
      "terraform show*": "allow",
      "terraform output*": "allow",
      "terraform state list*": "allow",
      "terraform state show*": "allow",
      "terraform workspace*": "allow",
      "terraform providers*": "allow",
      "terraform plan*": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "terraform init*": "ask"
    },
    "webfetch": "ask",
    "external_directory": {
      "~/SourceControl/**": "allow",
      "~/Documents/Notes/**": "allow"
    }
  },

  "agent": {
    "title": {
      "prompt": "Generate a session title as a short description, it should be 3-6 words summarizing the main topic or task of the conversation. Return only the title string, nothing else."
    },
    "build": {
      "permission": {
        "edit": {
          "*": "ask",
          "~/SourceControl/**": "allow",
          "~/Documents/Notes/**": "allow"
        }
      }
    }
  },

  "formatter": {
    "prettier": {
      "disabled": false
    }
  },

  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "{env:HOME}/SourceControl",
        "{env:HOME}/Documents/Notes"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": true
    },
    "1password": {
      "type": "local",
      "command": ["1password-mcp"],
      "enabled": true
    }{{ if eq .profile "work" }},
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true
    }{{ end }}
  },

  "autoupdate": true,
  "snapshot": true,
  "share": "manual",

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "*.log",
      ".next/**",
      "target/**"
    ]
  }
}
