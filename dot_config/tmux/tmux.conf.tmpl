{{ if eq .profile "work" -}}
# ==========================
# Tmux Configuration
# ==========================
# Prefix: Ctrl-Space
# Inspired by: https://micahkepe.com/blog/tmux-config/

# ==========================
# General Settings
# ==========================

# Set true color support
set -g default-terminal "screen-256color"
set -ga terminal-overrides ",xterm-256color:Tc"

# Pass through modified Enter/other extended keys (needed by pi/opencode TUIs)
set -g extended-keys on

# Change prefix from C-b to C-Space
unbind C-b
set-option -g prefix C-Space
bind-key C-Space send-prefix

# Faster command sequences (reduce escape time)
set -s escape-time 10
set -sg repeat-time 600
set -s focus-events on

# Increase history limit
set -g history-limit 10000

# Enable mouse support
set -g mouse on

# Start windows and panes at 1, not 0
set -g base-index 1
setw -g pane-base-index 1

# Auto renumber windows on close
set -g renumber-windows on

# Automatically set window title
setw -g automatic-rename on
set -g set-titles on

# Display settings
set -g display-panes-time 800
set -g display-time 1000
set -g status-interval 10

# ==========================
# Key Bindings
# ==========================

# Reload configuration
bind r source-file ~/.config/tmux/tmux.conf \; display "Config reloaded!"

# Better window splitting (more intuitive)
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
unbind '"'
unbind %

# Create new window in current path
bind c new-window -c "#{pane_current_path}"

# Pane navigation with vim-style keys
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# Pane resizing
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# Window navigation
bind -r C-h previous-window
bind -r C-l next-window

# tmux-sessionizer: Fuzzy find and switch to project directories
bind f run-shell "tmux neww ~/.config/tmux/scripts/tmux-sessionizer.sh"

# Session switching popup with fzf
bind s display-popup -E "~/.config/tmux/scripts/session-fzf.sh"

# ==========================
# Copy Mode (Vi-style)
# ==========================

# Enter copy mode with prefix + [
setw -g mode-keys vi

# Vi-like selection in copy mode
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi C-v send -X rectangle-toggle
bind -T copy-mode-vi y send -X copy-pipe-and-cancel 'pbcopy'
bind -T copy-mode-vi Escape send -X cancel
bind -T copy-mode-vi H send -X start-of-line
bind -T copy-mode-vi L send -X end-of-line

# Allow tmux clipboard to copy to system clipboard
set -s set-clipboard on

# Copy to macOS clipboard
bind y run -b "tmux save-buffer - | pbcopy"

# ==========================
# vim-tmux-navigator (DISABLED)
# ==========================
# Disabled to avoid conflicts with k9s shortcuts.
# k9s uses Ctrl-k (kill resource) and Ctrl-j (navigation).
# Use prefix-based navigation instead: Ctrl-Space + h/j/k/l
#
# If you need vim-tmux integration back, consider using Alt-based
# shortcuts or a different modifier key that doesn't conflict with k9s.
# ==========================

# NOTE: Ctrl-h/j/k/l are now available for applications like k9s and vim
# Use the following prefix-based shortcuts instead:
#   Ctrl-Space + h/j/k/l - Navigate panes (lines 64-67)
#   Ctrl-Space + H/J/K/L - Resize panes (lines 70-73)

# ==========================
# Plugins (TPM)
# ==========================

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'tmux-plugins/tmux-battery'
set -g @plugin 'tmux-plugins/tmux-cpu'

# tmux-continuum: auto-save sessions
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'

# tmux-resurrect: restore vim/neovim sessions
set -g @resurrect-strategy-vim 'session'
set -g @resurrect-strategy-nvim 'session'
set -g @resurrect-capture-pane-contents 'on'

# ==========================
# Catppuccin Theme
# ==========================

# Configure Catppuccin plugin
set -g @catppuccin_flavor "mocha"
set -g @catppuccin_window_status_style "rounded"

# Disable window status hints
set -g @catppuccin_status_default_window_behavior "no"

# Load Catppuccin (manually cloned, not via TPM due to naming conflicts)
run ~/.config/tmux/plugins/catppuccin/tmux/catppuccin.tmux

# Disable the hints status line by unsetting status-format[1]
set -g status-format[1] ""

# Override window status format to show window name instead of pane title
setw -g window-status-format "#[fg=#11111b,bg=#{@thm_overlay_2}]#[fg=#181825,reverse]#[none]#I #[fg=#cdd6f4,bg=#{@thm_surface_0}] #W#[fg=#181825,reverse]#[none]"
setw -g window-status-current-format "#[fg=#11111b,bg=#{@thm_mauve}]#[fg=#181825,reverse]#[none]#I #[fg=#cdd6f4,bg=#{@thm_surface_1}] #W#[fg=#181825,reverse]#[none]"
setw -g window-status-separator ""

# Customize status bar - show active pane's directory instead of hostname
# (hostname never changes when SSHing into other machines inside a pane,
# so it's a static, low-value display; cwd is dynamic and actually useful)
set -g status-right-length 100
set -g status-left-length 100
set -g status-left "#{E:@catppuccin_status_directory}"
set -g status-right "#{E:@catppuccin_status_session}"
set -agF status-right "#{E:@catppuccin_status_battery}"

# ==========================
# Initialize TMUX plugin manager
# (keep this line at the very bottom of tmux.conf)
# ==========================
run '~/.config/tmux/plugins/tpm/tpm'

{{ else -}}
