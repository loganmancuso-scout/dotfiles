#
# Colors are Catppuccin Mocha for macOS.
{{- $white := "#FFFFFF" -}}
{{- $lavender := "#B4BEFE" -}}
{{- $rosepink := "#E8A2AF" -}}
{{- $green := "#A6E3A1" -}}
{{- $peach := "#FAB387" -}}
{{- $red := "#F38BA8" -}}

format = """
$os$shell$terraform$directory$git_branch$git_status 
$cmd_duration$character\
"""

[line_break]
disabled = true

[character]
success_symbol = '[❯](bold {{ $green }})'
error_symbol = '[❯](bold {{ $red }})'
format = '$symbol '
disabled = false

[os]
format = '[$symbol ]($style)'
style = 'fg:{{ $white }}'
disabled = false 

[os.symbols]
Macos = ''

[shell]
zsh_indicator = "󰬡"
bash_indicator = "󱆃"
powershell_indicator = "\ue683"
style = 'fg:{{ $white }}'
disabled = false

[terraform]
format = '[$workspace ]($style)'
style = 'fg:{{ $lavender }}'

[directory]
style = 'fg:{{ $rosepink }}'
format = '[$path ]($style)'
truncation_length = 2

[git_branch]
symbol = ''
style = 'fg:{{ $green }}'
format = '[$symbol$branch]($style)'

[git_status]
style = 'fg:{{ $green }}'
format = '([$all_status$ahead_behind]($style))'

[cmd_duration]
min_time = 2000
style = 'fg:{{ $peach }}'
format = '[󰔛 $duration ]($style)'
