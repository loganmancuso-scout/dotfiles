# Author: Logan Mancuso | LastEdit: 2026-08-20

format = """
$os$shell$terraform$directory$git_branch$git_status 
$cmd_duration$character\
"""

[line_break]
disabled = true

[character]
success_symbol = '[❯](bold #A6E3A1)'
error_symbol = '[❯](bold #F38BA8)'
format = '$symbol '
disabled = false

[os]
format = '[$symbol ]($style)'
style = 'fg:#FFFFFF'
disabled = false 

[os.symbols]
Linux = '󰌽'
Pop = '󰌽'
Ubuntu = '󰌽'
Windows = '󰍹'
Macos = ''
Android = '🤖'

[shell]
{{ if eq .chezmoi.os "android" -}}
# Termux's terminal app has no Nerd Font glyphs available, so the usual
# private-use-area icons below render as tofu boxes — fall back to plain
# emoji, which Android renders natively via its own emoji font.
zsh_indicator = "🐚"
bash_indicator = "🅱️"
{{ else -}}
zsh_indicator = "󰬡"
bash_indicator = "󱆃"
{{ end -}}
powershell_indicator = "\ue683"
style = 'fg:#FFFFFF'
disabled = false

[terraform]
format = '[$workspace ]($style)'
style = 'fg:#B4BEFE'

[directory]
style = 'fg:#E8A2AF'
format = '[$path ]($style)'
truncation_length = 2

[git_branch]
{{ if eq .chezmoi.os "android" -}}
symbol = '🌿'
{{ else -}}
symbol = ''
{{ end -}}
style = 'fg:#A6E3A1'
format = '[$symbol$branch]($style)'

[git_status]
style = 'fg:#A6E3A1'
format = '([$all_status$ahead_behind]($style))'

[cmd_duration]
min_time = 2000
style = 'fg:#FAB387'
{{ if eq .chezmoi.os "android" -}}
format = '[⏱ $duration ]($style)'
{{ else -}}
format = '[󰔛 $duration ]($style)'
{{ end -}}
