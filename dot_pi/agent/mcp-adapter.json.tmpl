{
  "mcpServers": {
    "1password": {
      "command": "1password-mcp"
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "auth": "bearer",
      "bearerToken": "!gh auth token"
    },
    "jira": {
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "auth": "oauth"
    },
    "aws": {
      "command": "uvx",
      "args": ["mcp-proxy-for-aws@1.6.4", "https://aws-mcp.us-east-1.api.aws/mcp"],
      "env": {
        "AWS_MCP_PROXY_PROFILES": "aft-management audit co-sales-and-ops-planning-dev data-app-dev data-app-prd data-dev data-prd data-sbx-001 digital-dev digital-prd digital-sbx-001 digital-stg integration-dev integration-prd integration-sbx-001 log-archive pe-network-dev pe-network-prd plant-network-prd plant-app-prd plant-app-dev ScoutMotorsInc scout-tools-dev scout-tools-prd vehicle-connectivity-sbx-001 vehicle-infotainment-dev wiz-outpost"
      }
    },
    "workiq": {
      "command": "npx",
      "args": ["-y", "@microsoft/workiq@1.0.0", "mcp"],
      "disabled": false
    },
    "nutanix": {
      "command": "{{ .chezmoi.homeDir }}/.pi/mcp/nutanix-mcp-server/.venv/bin/nutanix-mcp",
      "env": {
        "NUTANIX_HOST": "prismcentral.usubv.plant.scoutway.io",
        "NUTANIX_PORT": "9440",
        "NUTANIX_USERNAME": "!op read op://LoganMancuso-Automation/svgvb4fqxnvlcvrbdrdhwkwnxy/username",
        "NUTANIX_PASSWORD": "!op read op://LoganMancuso-Automation/svgvb4fqxnvlcvrbdrdhwkwnxy/password",
        "NUTANIX_VERIFY_SSL": "false",
        "NUTANIX_TIMEOUT": "30"
      },
      "disabled": false
    },
    "browsermcp": {
      "command": "npx",
      "args": ["@browsermcp/mcp@latest"]
    },
    "zscaler": {
      "command": "uvx",
      "args": ["zscaler-mcp"],
      "env": {
        "ZSCALER_CLIENT_ID": "!op read op://LoganMancuso-Automation/lxuyja6uaielrhji7xg2s4fhta/jv5pcwtzgdsawzsgejiohec3ha",
        "ZSCALER_CLIENT_SECRET": "!op read op://LoganMancuso-Automation/lxuyja6uaielrhji7xg2s4fhta/password",
        "ZSCALER_CUSTOMER_ID": "!op read op://LoganMancuso-Automation/lxuyja6uaielrhji7xg2s4fhta/rhq6qnyifnvgar3eezlhkmkgoq",
        "ZSCALER_VANITY_DOMAIN": "!op read op://LoganMancuso-Automation/lxuyja6uaielrhji7xg2s4fhta/6jymnubzaxtbfz3hez3lkkjjqq"
      },
      "description": "Zscaler MCP server in read-only mode by default"
    },
    "mist-cloud": {
      "url": "https://mcp.ai.juniper.net/mcp/mist",
      "auth": "bearer",
      "bearerToken": "!op read op://wqghe4bimpx7yuizvsas4ysiwu/6qo2ly55qzuxileusuy4bba6ve/password",
      "headers": {
        "X-Mist-Base-URL": "https://api.ac2.mist.com"
      }
    }
  }
}
