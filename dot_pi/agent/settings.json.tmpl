{
  "defaultProvider": "{{ if eq .profile "work" }}amazon-bedrock{{ else }}ollama{{ end }}",
  "defaultModel": "{{ if eq .profile "work" }}us.anthropic.claude-sonnet-5{{ else }}qwen2.5-coder:7b{{ end }}",
  "defaultThinkingLevel": "medium",
  "compaction": {
    "enabled": true,
    "reserveTokens": 10000,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "enableSkillCommands": true,
  "extensions": [
    "extensions/notification.ts",
    "extensions/ask-user-question.ts",
    "extensions/web-fetch/index.ts",
    "extensions/prompt-snippets/index.ts",
    "extensions/custom-header.ts",
    "extensions/browser/index.ts",
    "extensions/subagents/pi-extension/subagents/index.ts",
    "extensions/observational-memory/src/index.ts"
  ],
  "observational-memory": {
    "models": {
{{- if eq .profile "work" }}
      "observer": { "provider": "amazon-bedrock", "id": "us.anthropic.claude-sonnet-5", "thinking": "low" },
      "consolidator": { "provider": "amazon-bedrock", "id": "us.anthropic.claude-sonnet-5", "thinking": "medium" }
{{- else }}
      "observer": { "provider": "ollama", "id": "qwen2.5-coder:7b", "thinking": "low" },
      "consolidator": { "provider": "ollama", "id": "qwen2.5-coder:7b", "thinking": "medium" }
{{- end }}
    }
  },
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-sessions"
  ],
  "sessions": {
    "autoTitle": {
      "model": "{{ if eq .profile "work" }}amazon-bedrock/us.amazon.nova-pro-v1:0{{ else }}ollama/qwen2.5-coder:7b{{ end }}",
      "thinkingLevel": "off"
    }
  },
  "enabledModels": [
    "amazon-bedrock/us.anthropic.claude-sonnet-5",
    "amazon-bedrock/us.anthropic.claude-sonnet-4-6",
    "amazon-bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0",
    "amazon-bedrock/us.anthropic.claude-opus-4-8",
    "amazon-bedrock/us.anthropic.claude-opus-4-7",
    "amazon-bedrock/us.anthropic.claude-opus-4-6-v1",
    "amazon-bedrock/us.anthropic.claude-opus-4-5-20251101-v1:0",
    "amazon-bedrock/us.openai.gpt-6-astra",
    "amazon-bedrock/us.openai.gpt-5.6-terra",
    "amazon-bedrock/us.openai.gpt-5.6-sol",
    "amazon-bedrock/us.openai.gpt-5.6-luna",
    "amazon-bedrock/us.xai.grok-4.6",
    "amazon-bedrock/us.amazon.nova-pro-v1:0",
    "amazon-bedrock/us.amazon.nova-2-lite-v1:0",
    "amazon-bedrock/us.amazon.nova-micro-v1:0",
    "amazon-bedrock/deepseek.v3.2",
    "amazon-bedrock/qwen.qwen3-coder-30b-a3b-v1:0",
    "amazon-bedrock/moonshotai.kimi-k2.5",
    "amazon-bedrock/zai.glm-4.7-flash",
    "amazon-bedrock/openai.gpt-oss-20b-1:0",
    "github-copilot/claude-sonnet-5",
    "github-copilot/claude-opus-5",
    "github-copilot/claude-opus-4.8",
    "github-copilot/gpt-5.6-luna",
    "github-copilot/gpt-5.6-sol",
    "github-copilot/gpt-5.6-terra",
    "github-copilot/gpt-5.3-codex",
    "github-copilot/gpt-5.5",
    "github-copilot/mai-code-1-flash-picker",
    "ollama/*"
  ],
  "theme": "dark"
}

