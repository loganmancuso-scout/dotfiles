[Unit]
Description=Restic Backup to USB
# Only run if the backup drive is mounted
ConditionPathIsMountPoint=/media/backup
After=media-backup.mount

[Service]
Type=oneshot
ExecStart=/bin/bash %h/SourceControl/Personal/backup-restore/scripts/restic-backup.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
