function tflogin() {
  echo "Setting OpenBao Secrets"
  # set vault url and vault token and unseal key
  export VAULT_ADDR="$(op item get "Tofu OpenBao" --format json | jq -r '.urls[0].href')"
  export VAULT_TOKEN="$(op item get "Tofu OpenBao" --fields label=password --reveal)"
  export UNSEAL_KEY_1="$(op item get "Tofu OpenBao" --fields label="UNSEAL_KEY_1")"
  echo "Setting RustFS Secrets"
  # set rustfs secret token and secret id
  export AWS_ACCESS_KEY_ID="$(op item get "rustfs accesskey" --vault "automation" --fields label=username)"
  export AWS_SECRET_ACCESS_KEY="$(op item get "rustfs accesskey" --vault "automation" --fields label=password --reveal)"
  # set op service account secret token
  echo "Setting 1Password Secrets"
  export OP_CONNECT_TOKEN="$(op item get "Home Access Token: OpenTofu" --fields label=credential --reveal)"
  
}

function tfunseal() {
  [[ -z "$UNSEAL_KEY_1" || -z "$VAULT_TOKEN" ]] && tflogin
  vault status -tls-skip-verify
  vault operator unseal -tls-skip-verify $UNSEAL_KEY_1
  vault status -tls-skip-verify
  vault login -tls-skip-verify token=$VAULT_TOKEN 
}

## Programming Helper ##
function newdate() {
  today_=$(date +%Y-%m-%d)
  tag_="LastEdit:"
  updated_files=()

  process_file() {
    local file_="$1"
    [[ -f "$file_" ]] || return

    if grep -q "$tag_" "$file_"; then
      sed -i "s/\($tag_ \)[0-9\-]*/\1$today_/g" "$file_"
      updated_files+=("$file_")
    elif grep -q "Author:" "$file_"; then
      sed -i "s/\(Author:.*\)/\1 | $tag_ $today_/" "$file_"
      updated_files+=("$file_")
    fi
  }

  for arg in "$@"; do
    if [[ -d "$arg" ]]; then
      while IFS= read -r -d '' file_; do
        process_file "$file_"
      done < <(find "$arg" -type f -print0)
    elif [[ -f "$arg" ]]; then
      process_file "$arg"
    else
      echo "Warning: '$arg' is not a valid file or directory" >&2
    fi
  done

  if (( ${#updated_files[@]} > 0 )); then
    echo "Updated ${#updated_files[@]} file(s) with '$tag_ $today_':"
    printf ' - %s\n' "${updated_files[@]}"
  else
    echo "No files were updated."
  fi
}

