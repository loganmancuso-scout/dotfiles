# #BitWarden Authentication ##
function bw-auth() {
  # Check if BW_SESSION is set in the current environment
  if [ -z "$BW_SESSION" ]; then
    # echo "BW_SESSION is not set."
    # Check if the /tmp/bw.env file exists and source it
    if [ -f /tmp/bw.env ]; then
      # echo "Sourcing BW_SESSION from /tmp/bw.env"
      source /tmp/bw.env
    fi
    # If BW_SESSION is still not set, log in to Bitwarden
    if [ -z "$BW_SESSION" ]; then
      echo "Logging in to Bitwarden..."
      local login_output=$(bw unlock --raw) # Use --raw to get the session key directly
      if [ $? -ne 0 ]; then
        echo "Failed to log in to Bitwarden."
        return 1
      fi
      eval "BW_SESSION=$login_output"
      echo "export BW_SESSION=\"$login_output\"" > /tmp/bw.env
    fi
  fi
}

## OpenTofu ##
alias k="kubectl"
alias tf="tofu"
alias tfi="tofu init --reconfigure --upgrade"
alias tfc="find . -maxdepth 1 -type l -delete"
alias tffmt="tofu fmt -recursive"
alias tfsclear='tofu state rm $(tofu state list)'

function tfauth() {
  bw-auth
  # Retrieve the JSON from Bitwarden
  echo "Retrieving Tofu Secrets"
  local vault_json=$(bw get item "Tofu Secrets" --session "$BW_SESSION")
  if [ $? -ne 0 ]; then
    echo "Failed to retrieve item from Bitwarden."
    return 1
  fi

  # Use jq to extract the name and value fields and prefix them with 'export'
  export_commands=$(echo "$vault_json" | jq -r '.fields[] | "export \(.name)=\(.value)"')
  if [ $? -ne 0 ]; then
    echo "Failed to parse JSON from Bitwarden."
    return 1
  fi

  # Evaluate the export commands to set the environment variables
  echo "Setting Tofu Secrets"
  eval "$export_commands"
}

function tfunseal() {
  tfauth
  export VAULT_ADDR="https://vault.local"
  vault status -tls-skip-verify
  vault operator unseal -tls-skip-verify $UNSEAL_KEY_1
  vault status -tls-skip-verify
  vault login -tls-skip-verify token=$VAULT_TOKEN 
}

## Programming Helper ##
function newdate() {
  today_=$(date +%Y-%m-%d)
  tag_="LastEdit:"
  updated_files=()

  process_file() {
    local file_="$1"
    [[ -f "$file_" ]] || return

    if grep -q "$tag_" "$file_"; then
      sed -i "s/\($tag_ \)[0-9\-]*/\1$today_/g" "$file_"
      updated_files+=("$file_")
    elif grep -q "Author:" "$file_"; then
      sed -i "s/\(Author:.*\)/\1 | $tag_ $today_/" "$file_"
      updated_files+=("$file_")
    fi
  }

  for arg in "$@"; do
    if [[ -d "$arg" ]]; then
      while IFS= read -r -d '' file_; do
        process_file "$file_"
      done < <(find "$arg" -type f -print0)
    elif [[ -f "$arg" ]]; then
      process_file "$arg"
    else
      echo "Warning: '$arg' is not a valid file or directory" >&2
    fi
  done

  if (( ${#updated_files[@]} > 0 )); then
    echo "Updated ${#updated_files[@]} file(s) with '$tag_ $today_':"
    printf ' - %s\n' "${updated_files[@]}"
  else
    echo "No files were updated."
  fi
}

