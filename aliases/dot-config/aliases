## Programming Helper ##

function newfile() {
  local filename="$1"
  local today=$(date +%Y-%m-%d)
  if [ -z "$filename" ]; then
    echo "Usage: newfile <filename>"
    return 1
  fi
  {
    echo "# PROPRIETARY: Scout Motors Inc."
    echo "# Author: Logan Mancuso | LastEdit: $today"
    echo
  } > "$filename"
  echo "Created $filename with header."
}

# changes the date on a file if it has LastEdit date tag
function newdate() {
  local today=$(date +%Y-%m-%d)
  local files=()

  # Collect files from arguments (folders or files)
  for arg in "$@"; do
    if [ -d "$arg" ]; then
      # Find all regular files under the directory
      while IFS= read -r -d '' file; do
        files+=("$file")
      done < <(find "$arg" -type f -print0)
    elif [ -f "$arg" ]; then
      files+=("$arg")
    fi
  done

  # Update LastEdit date in each file
  for file in "${files[@]}"; do
    if LC_ALL=C grep -qE "# Author:.*\| LastEdit: [0-9]{4}-[0-9]{2}-[0-9]{2}" "$file"; then
      sed -i '' -E "s|(# Author:.*\| LastEdit: )[0-9]{4}-[0-9]{2}-[0-9]{2}|\1$today|" "$file"
      echo "Updated: $file"
    else
      echo "Skipped: $file (no LastEdit tag found)"
    fi
  done
}

