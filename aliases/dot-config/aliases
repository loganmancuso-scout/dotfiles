# Smart switch: auto-pulls when landing on main
function gco() {
  git switch "$@"
  [[ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" == "main" ]] && git pull
}

# Create and switch to a new branch
function gnb() {
  if [[ -z "$1" ]]; then
    echo "Usage: gnb <branch-name>"
    return 1
  fi
  git switch -c "$1"
}

# Finish a feature branch: switch to main, pull, delete locally + remotely
# Usage: gclean [branch] [--force]
function gclean() {
  local branch=""
  local force=false

  for arg in "$@"; do
    case "$arg" in
      --force) force=true ;;
      *)       branch="$arg" ;;
    esac
  done

  branch="${branch:-$(git rev-parse --abbrev-ref HEAD 2>/dev/null)}"

  if [[ "$branch" == "main" ]]; then
    echo "Already on main, nothing to clean."
    return 1
  fi

  git switch main && git pull || return 1

  if $force; then
    git branch -D "$branch" && echo "Force deleted local branch: $branch"
  else
    git branch -d "$branch" && echo "Deleted local branch: $branch"
  fi

  git push origin --delete "$branch" 2>/dev/null && echo "Deleted remote branch: $branch"
  git fetch --prune
}

