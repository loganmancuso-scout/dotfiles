## Programming Helper ##
function newfile() {
  local filename="$1"
  local today=$(date +%Y-%m-%d)
  if [ -z "$filename" ]; then
    echo "Usage: newfile <filename>"
    return 1
  fi
  {
    echo "## Author: Logan Mancuso | LastEdit: 2025-09-15$today"
    echo
  } > "$filename"
  echo "Created $filename with header."
}

function newdate() {
  today_=$(date +%Y-%m-%d)
  tag_="LastEdit:"
  updated_files=()

  process_file() {
    local file_="$1"
    echo "file:$file_"
    [[ -f "$file_" ]] || return

    if grep -q "$tag_" "$file_"; then
      echo "1"
        sed -i '' "s/\($tag_ \)[0-9\-]*/\1$today_/g" "$file_"
      updated_files+=("$file_")
    elif grep -q "Author:" "$file_"; then
      echo "2"
        sed -i '' "s/\(Author:.*\)/\1 | $tag_ $today_/" "$file_"
      updated_files+=("$file_")
    fi
  }

  for arg in "$@"; do
    if [[ -d "$arg" ]]; then
      while IFS= read -r -d '' file_; do
        process_file "$file_"
      done < <(find "$arg" -type f -print0)
    elif [[ -f "$arg" ]]; then
      process_file "$arg"
    else
      echo "Warning: '$arg' is not a valid file or directory" >&2
    fi
  done

  if (( ${#updated_files[@]} > 0 )); then
    echo "Updated ${#updated_files[@]} file(s) with '$tag_ $today_':"
    printf ' - %s\n' "${updated_files[@]}"
  else
    echo "No files were updated."
  fi
}

