{{ if eq .profile "work" -}}
Include {{ .chezmoi.homeDir }}/.colima/ssh_config
Include {{ .chezmoi.homeDir }}/.ssh/1Password/config

{{ end -}}
Host *
{{ if eq .chezmoi.os "darwin" -}}
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{ else if eq .chezmoi.os "android" -}}
  # No 1Password app/agent on Termux/Android — sign in directly with the
  # local private key files under ~/.ssh instead of the 1Password socket.
  IdentityFile ~/.ssh/personal_ed.priv
  IdentityFile ~/.ssh/shared_ed.priv
{{ else -}}
  IdentityAgent ~/.1password/agent.sock
{{ end -}}
  StrictHostKeyChecking no

