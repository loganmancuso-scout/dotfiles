{
  "$schema": "https://opencode.ai/config.json",

  // ============================================================================
  // PROVIDER & MODEL CONFIGURATION
  // ============================================================================

  "provider": {
    "github-copilot": {},
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localai.app.vpc.home.arpa:11434/v1"
      },
      "models": {
        "qwen3-coder-next:latest": {
          "name": "qwen3-coder-next:latest",
          "tools": true
        },
        "qwen3-coder:30b": {
          "name": "qwen3-coder:30b",
          "tools": true
        },
        "deepseek-r1:1.5b": {
          "name": "deepseek-r1:1.5b",
          "reasoning": true
        },
        "deepseek-r1:7b": {
          "name": "deepseek-r1:7b",
          "reasoning": true
        },
        "deepseek-r1:8b": {
          "name": "deepseek-r1:8b",
          "reasoning": true
        },
        "deepseek-r1:14b": {
          "name": "deepseek-r1:14b",
          "reasoning": true
        },
        "gemma3:12b": {
          "name": "gemma3:12b"
        },
        "llama3.2:latest": {
          "name": "llama3.2:latest"
        },
        "qwen3.5:9b": {
          "name": "qwen3.5:9b"
        },
        "qwen3.5:4b": {
          "name": "qwen3.5:4b"
        },
        "qwen3.5:2b": {
          "name": "qwen3.5:2b"
        },
        "mistral:latest" : {
          "name": "mistral:latest",
          "tools": true
        },
        "mistral-small3.2:latest" : {
          "name": "mistral-small3.2:latest",
          "tools": true
        }
      }
    }
  },

  // Default model for primary agents
  "model": "github-copilot/claude-sonnet-4.6",

  // Smaller/faster model for lightweight tasks (title generation, etc.)
  "small_model": "github-copilot/claude-haiku-4.5",

  // ============================================================================
  // PERMISSIONS CONFIGURATION
  // ============================================================================

  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "grep*": "allow"
    },
    "webfetch": "ask"
  },

  // ============================================================================
  // FORMATTER CONFIGURATION
  // ============================================================================

  "formatter": {
    "prettier": {
      "disabled": false
    }
  },

  // ============================================================================
  // MCP (MODEL CONTEXT PROTOCOL) SERVERS
  // ============================================================================

  "mcp": {
    // Filesystem MCP - Access to your SourceControl directory
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "{env:HOME}/SourceControl"
      ],
      "enabled": true
    },

    // GitHub MCP - Query repos, issues, PRs, and code
    // Requires GITHUB_TOKEN env var (set via aliases: op read "op://Personal/Github/token")
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": true
    }
  },

  // ============================================================================
  // GENERAL SETTINGS
  // ============================================================================

  "autoupdate": true,
  "snapshot": true,
  "share": "manual",

  "server": {
    "port": 4096,
    "hostname": "127.0.0.1"
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "*.log",
      ".next/**",
      "target/**"
    ]
  }
}
