{
  "$schema": "https://opencode.ai/config.json",

  // ============================================================================
  // PROVIDER & MODEL CONFIGURATION
  // ============================================================================

  "provider": {
    "github-copilot": {},
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localai.app.vpc.home.arpa:11434/v1"
      },
      "models": {
        "qwen3-coder-next:latest": {
          "name": "qwen3-coder-next:latest",
          "tools": true
        },
        "qwen3-coder:30b": {
          "name": "qwen3-coder:30b",
          "tools": true
        },
        "deepseek-r1:1.5b": {
          "name": "deepseek-r1:1.5b",
          "reasoning": true
        },
        "deepseek-r1:7b": {
          "name": "deepseek-r1:7b",
          "reasoning": true
        },
        "deepseek-r1:8b": {
          "name": "deepseek-r1:8b",
          "reasoning": true
        },
        "deepseek-r1:14b": {
          "name": "deepseek-r1:14b",
          "reasoning": true
        },
        "gemma3:12b": {
          "name": "gemma3:12b"
        },
        "llama3.2:latest": {
          "name": "llama3.2:latest"
        },
        "qwen3.5:9b": {
          "name": "qwen3.5:9b"
        },
        "qwen3.5:4b": {
          "name": "qwen3.5:4b"
        },
        "qwen3.5:2b": {
          "name": "qwen3.5:2b"
        },
        "mistral:latest" : {
          "name": "mistral:latest",
          "tools": true
        },
        "mistral-small3.2:latest" : {
          "name": "mistral-small3.2:latest",
          "tools": true
        }
      }
    }
  },

  // Default model for primary agents
  "model": "github-copilot/claude-sonnet-4.6",

  // Smaller/faster model for lightweight tasks (title generation, etc.)
  "small_model": "github-copilot/claude-haiku-4.5",

  // ============================================================================
  // PERMISSIONS CONFIGURATION
  // ============================================================================

  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",

      // git
      "git status": "allow",
      "git diff": "allow",
      "git log*": "allow",
      "git show*": "allow",

      // general file utilities
      "ls*": "allow",
      "cat*": "allow",
      "grep*": "allow",
      "find*": "allow",
      "rg*": "allow",
      "tail*": "allow",
      "head*": "allow",
      "which*": "allow",
      "whereis*": "allow",
      "jq*": "allow",
      "yq*": "allow",

      // network read-only
      "curl*": "allow",
      "wget*": "allow",
      "ping*": "allow",
      "dig*": "allow",
      "nslookup*": "allow",
      "host*": "allow",
      "nc*": "allow",
      "netcat*": "allow",
      "traceroute*": "allow",
      "netstat*": "allow",
      "ss*": "allow",

      // kubectl read-only
      "kubectl get*": "allow",
      "kubectl describe*": "allow",
      "kubectl logs*": "allow",
      "kubectl top*": "allow",
      "kubectl config*": "allow",
      "kubectl cluster-info*": "allow",
      "kubectl version": "allow",
      "kubectl api-resources": "allow",
      "kubectl api-versions": "allow",
      "kubectl explain*": "allow",
      "kubectl port-forward*": "allow",
      // kubectl mutating
      "kubectl apply*": "ask",
      "kubectl delete*": "ask",
      "kubectl scale*": "ask",
      "kubectl rollout*": "ask",
      "kubectl exec*": "ask",
      "kubectl debug*": "ask",

      // helm read-only
      "helm list*": "allow",
      "helm status*": "allow",
      "helm get*": "allow",
      "helm history*": "allow",
      "helm search*": "allow",
      "helm show*": "allow",
      "helm version": "allow",
      "helm diff*": "allow",
      // helm mutating
      "helm upgrade*": "ask",
      "helm install*": "ask",
      "helm uninstall*": "ask",
      "helm rollback*": "ask",

      // docker read-only
      "docker ps*": "allow",
      "docker images*": "allow",
      "docker inspect*": "allow",
      "docker logs*": "allow",
      "docker version": "allow",
      "docker info": "allow",
      "docker stats*": "allow",
      "docker network ls*": "allow",
      "docker volume ls*": "allow",
      // docker mutating
      "docker build*": "ask",
      "docker run*": "ask",
      "docker compose*": "ask",
      "docker push*": "ask",
      "docker pull*": "ask",
      "docker exec*": "ask",
      "docker stop*": "ask",
      "docker start*": "ask",
      "docker restart*": "ask",
      "docker rm*": "ask",
      "docker rmi*": "ask",

      // tofu read-only
      "tofu version": "allow",
      "tofu fmt*": "allow",
      "tofu validate*": "allow",
      "tofu show*": "allow",
      "tofu output*": "allow",
      "tofu state list*": "allow",
      "tofu state show*": "allow",
      "tofu workspace*": "allow",
      "tofu providers*": "allow",
      // tofu mutating
      "tofu plan*": "ask",
      "tofu apply*": "ask",
      "tofu destroy*": "ask",
      "tofu init*": "ask",

      // terraform read-only (alias coverage)
      "terraform version": "allow",
      "terraform fmt*": "allow",
      "terraform validate*": "allow",
      "terraform show*": "allow",
      "terraform output*": "allow",
      "terraform state list*": "allow",
      "terraform state show*": "allow",
      "terraform workspace*": "allow",
      "terraform providers*": "allow",
      // terraform mutating
      "terraform plan*": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "terraform init*": "ask"
    },
    "webfetch": "ask",
    "external_directory": {
      "~/Documents/Notes/projects/**": "allow",
      "~/Documents/Notes/templates/**": "allow"
    }
  },

  // ============================================================================
  // FORMATTER CONFIGURATION
  // ============================================================================

  "formatter": {
    "prettier": {
      "disabled": false
    }
  },

  // ============================================================================
  // MCP (MODEL CONTEXT PROTOCOL) SERVERS
  // ============================================================================

  "mcp": {
    // Filesystem MCP - Access to SourceControl and Notes knowledge base
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "{env:HOME}/SourceControl",
        "{env:HOME}/Documents/Notes"
      ],
      "enabled": true
    },

    // GitHub MCP - Query repos, issues, PRs, and code
    // Requires GITHUB_TOKEN env var (set via aliases: op read "op://Personal/Github/token")
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": true
    }
  },

  // ============================================================================
  // GENERAL SETTINGS
  // ============================================================================

  "autoupdate": true,
  "snapshot": true,
  "share": "manual",


  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "*.log",
      ".next/**",
      "target/**"
    ]
  }
}
