#!/usr/bin/env bash
# opc-rename — backfill default "New session - <date>" titles using Copilot API
#   Requires: sqlite3, gh (authenticated), curl, python3
#   Usage: opc-rename
#          DRY_RUN=1 opc-rename    (preview without writing)
#   Override DB path: OPENCODE_DB=/path/to/other.db opc-rename

set -euo pipefail

DB="${OPENCODE_DB:-$HOME/.local/share/opencode/opencode.db}"
DRY_RUN="${DRY_RUN:-0}"

[[ -f "$DB" ]] || { echo "ERROR: database not found at $DB" >&2; exit 1; }

GH_TOKEN=$(op read "op://Employee/Github/work-token" 2>/dev/null || true)
if [[ -z "$GH_TOKEN" ]]; then
  echo "ERROR: could not read GitHub token from 1Password (op://Employee/Github/work-token)" >&2
  exit 1
fi

_call_copilot() {
  local prompt="$1"
  local escaped
  escaped=$(python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))' <<< "$prompt")
  curl -s -X POST "https://api.githubcopilot.com/chat/completions" \
    -H "Authorization: Bearer $GH_TOKEN" \
    -H "Content-Type: application/json" \
    -H "Copilot-Integration-Id: vscode-chat" \
    -d "{
      \"model\": \"gpt-4o-mini\",
      \"max_tokens\": 40,
      \"messages\": [{\"role\": \"user\", \"content\": ${escaped}}]
    }" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["choices"][0]["message"]["content"].strip())'
}

TMPFILE=$(mktemp /tmp/opencode-sessions.XXXXXX)
trap 'rm -f "$TMPFILE"' EXIT

sqlite3 "$DB" "
  SELECT s.id || '|' || strftime('%Y-%m-%d', s.time_created/1000, 'unixepoch')
  FROM session s
  WHERE s.title LIKE 'New session%'
    AND s.parent_id IS NULL
  ORDER BY s.time_created;
" > "$TMPFILE"

count=$(grep -c . "$TMPFILE" || true)

if [[ "$count" -eq 0 ]]; then
  echo "No sessions with default names found. Nothing to do."
  exit 0
fi

echo "Found $count session(s) to rename."
[[ "$DRY_RUN" == "1" ]] && echo "(DRY RUN - no changes will be written)"
echo ""

while IFS='|' read -r session_id date_str; do
  [[ -z "$session_id" ]] && continue

  user_text=$(sqlite3 "$DB" "
    SELECT substr(json_extract(p.data, '\$.text'), 1, 500)
    FROM part p
    JOIN message m ON p.message_id = m.id
    WHERE m.session_id = '${session_id}'
      AND json_extract(m.data, '\$.role') = 'user'
      AND json_extract(p.data, '\$.type') = 'text'
      AND json_extract(p.data, '\$.synthetic') IS NULL
      AND json_extract(p.data, '\$.text') IS NOT NULL
      AND trim(json_extract(p.data, '\$.text')) != ''
    ORDER BY p.time_created
    LIMIT 1;
  " 2>/dev/null || true)

  if [[ -z "$user_text" ]]; then
    echo "[$session_id] ($date_str) No user message found — skipping"
    continue
  fi

  prompt="Given this user message from an AI coding/ops session, generate a session title.
Rules:
- Output ONLY the title string, nothing else, no quotes, no punctuation at the end
- Title must be 3-6 words max
- Be specific about what was worked on
- Use title case

User message: ${user_text}"

  echo -n "[$session_id] ($date_str) Generating title... "

  new_title=$(_call_copilot "$prompt" 2>/dev/null || true)

  if [[ -z "$new_title" ]]; then
    echo "FAILED (API error) — skipping"
    continue
  fi

  echo "$new_title"

  if [[ "$DRY_RUN" != "1" ]]; then
    safe_title="${new_title//\'/\'\'}"
    sqlite3 "$DB" "UPDATE session SET title = '${safe_title}' WHERE id = '${session_id}';"
  fi
done < "$TMPFILE"

echo ""
echo "Done."
