# chezmoi source repo — no allowlist needed, chezmoi source paths ARE the
# managed content. Just ignore the usual junk.

.DS_Store
*.swp
*.swo

# vendored plugin trees — fetched automatically by chezmoi externals
# (see .chezmoiexternal.toml), not tracked in this repo
dot_config/tmux/plugins/

# vendored plugin trees — installed at runtime via manual git clone, only the
# single release file is dotfiles-managed
dot_config/zsh/zsh-autosuggestions/*
!dot_config/zsh/zsh-autosuggestions/zsh-autosuggestions.zsh

# Never track raw SSH key material, even if it's accidentally pulled into
# the source tree via `chezmoi add`/`chezmoi re-add` from ~/.ssh. This repo
# only ever manages plain pubkey *listings* (authorized_keys,
# allowed_signers) — never a standalone private or public key file.
dot_ssh/**/*.priv
dot_ssh/**/*.pem
dot_ssh/**/*.pub
dot_ssh/**/id_rsa*
dot_ssh/**/id_ed25519*
dot_ssh/**/id_ecdsa*
dot_ssh/**/id_dsa*
