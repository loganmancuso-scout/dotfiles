# Ignore everything
*

# Allow directories to be included, but not files within them
!*/

README.md
!stow-dotfiles.sh

# aliases
!aliases/dot-config/**

# bash
!bash/dot-bashrc

# continue
!continue/dot-continue/config.yaml

# git
!git/dot-gitconfig

# nvim
!nvim/dot-config/nvim/*.lua
!nvim/dot-config/nvim/*.json
!nvim/dot-config/nvim/*.toml

# ssh
!ssh/dot-ssh/config
!ssh/dot-ssh/known_hosts

# starship
!starship/dot-config/starship.toml

# systemd
!systemd/dot-config/systemd/user/*.service

# vscodium
!vscode/dot-config/VSCodium/User/*.json
!vscode/dot-vscode-oss/extensions/extensions.json

# zellij
!zellih/dot-config/zellij/*.kdl
!zellih/dot-config/zellij/**/*.kdl

# zoxide
!zoxide/dot-local/share/zoxide/db.zo

# zsh
zsh/dot-config/zsh/zsh-autosuggestions/**
!zsh/dot-config/zsh/zsh-autosuggestions/*.zsh
!zsh/dot-zshrc