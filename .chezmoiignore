# Package gating — profile is the primary axis (identity/access), OS is
# secondary (mechanical). See README.md "Profiles vs OS" for the rationale.
#
# NOTE: patterns here match TARGET paths (as applied to $HOME), not chezmoi's
# source-state naming — so ".aws" not "dot_aws".
#
# profile is effectively binary today, so its if/else reads as a direct
# positive statement ("if you're X, here's what doesn't apply to you")
# instead of the double-negative ne-based form ("exclude unless X").
# chezmoi.os now has three values (darwin/linux/android) since Android
# support was added — its block is if/else-if/else for the same reason.

{{ if eq .profile "work" }}
# excluded on work: personal-only stuff
{{ else }}
# excluded on personal: work-only stuff
.aws/**
.config/powershell/**
.vscode-oss/**
{{ end }}

{{ if eq .chezmoi.os "darwin" }}
# excluded on macOS: linux-only stuff
.config/VSCodium/**
.config/systemd/**
{{ else if eq .chezmoi.os "android" }}
# excluded on Android/Termux: macOS-only stuff, plus anything requiring
# systemd, Docker, VSCodium, ghostty, 1Password, or the pi/opencode agent
# tooling that isn't present on the phone.
.colima/**
Library/**
.config/systemd/**
.docker/**
.config/VSCodium/**
.vscode-oss/**
.config/ghostty/**
.config/1Password/**
.ssh/1Password/**
.pi/**
.config/opencode/**
{{ else }}
# excluded elsewhere: macOS-only stuff
.colima/**
Library/**
{{ end }}

# Vendored/runtime-managed plugin trees — installed by the tools themselves
# on first run (zsh-autosuggestions only tracks the single script file).
# NOTE: .config/tmux/plugins/** is intentionally NOT listed here — those
# paths are fetched via .chezmoiexternal.toml (git-repo externals for tpm
# and catppuccin) and must remain chezmoi-managed for that to apply.
.config/1Password/**
.ssh/1Password/**
.config/tmux/plugins/**

# Defense in depth: never let chezmoi apply raw SSH private/public key
# material into ~/.ssh on any device, even if one somehow lands in the
# source tree despite the .gitignore guard. authorized_keys and
# allowed_signers are plain pubkey listings, not standalone key files, and
# are intentionally excluded from this rule.
.ssh/*.priv
.ssh/*.pem
.ssh/*.pub
.ssh/id_rsa*
.ssh/id_ed25519*
.ssh/id_ecdsa*
.ssh/id_dsa*

# Repo-only docs — not meant to be applied to $HOME
README.md
